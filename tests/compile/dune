; The same source builds natively and with Melange. The ppx picks the code
; of each target, and both builds link the runtime through ppx_runtime_libraries.

(library
 (name sample_native)
 (modules sample_native)
 (preprocess
  (pps ppx_platform)))

(rule
 (copy sample.ml sample_native.ml))

(rule
 (copy sample.ml sample_js.ml))

(rule
 (copy dom.ml dom_native.ml))

(rule
 (copy dom.mli dom_native.mli))

(rule
 (copy dom.ml dom_js.ml))

(rule
 (copy dom.mli dom_js.mli))

(library
 (name sample_js)
 (modes melange)
 (modules sample_js)
 (preprocess
  (pps ppx_platform -- -js)))

(library
 (name dom_native)
 (modules dom_native)
 (preprocess
  (pps ppx_platform)))

(library
 (name dom_js)
 (modes melange)
 (modules dom_js)
 (preprocess
  (pps ppx_platform melange.ppx -- -js)))

(melange.emit
 (target out)
 (modules)
 (libraries sample_js dom_js)
 (module_systems commonjs))

(executable
 (name check)
 (modules check)
 (libraries sample_native dom_native ppx_platform.runtime))

(rule
 (alias runtest)
 (package ppx_platform)
 (action
  (with-stdout-to
   check.output
   (run ./check.exe))))
