; The same source builds natively and with Melange. The ppx picks the code
; of each target, and both builds link the runtime through ppx_runtime_libraries.

(library
 (name sample_native)
 (modules sample_native)
 (preprocess
  (pps ppx_platform)))

(rule
 (copy sample.ml sample_native.ml))

(rule
 (copy sample.ml sample_js.ml))

(rule
 (copy sample_new.ml sample_new_native.ml))

(rule
 (copy sample_new.ml sample_new_js.ml))

(library
 (name sample_js)
 (modes melange)
 (modules sample_js)
 (preprocess
  (pps ppx_platform -- -js)))

(library
 (name sample_new_native)
 (modules sample_new_native)
 (preprocess
  (pps ppx_platform)))

(library
 (name sample_new_js)
 (modes melange)
 (modules sample_new_js)
 (preprocess
  (pps ppx_platform -- -js)))

(melange.emit
 (target out)
 (modules)
 (libraries sample_js sample_new_js)
 (module_systems commonjs))

(executable
 (name check)
 (modules check)
 (libraries sample_native sample_new_native ppx_platform.runtime))

(rule
 (alias runtest)
 (package ppx_platform)
 (action
  (with-stdout-to
   check.output
   (run ./check.exe))))
