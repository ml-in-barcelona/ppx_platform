# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Platform-specific code for native and Melange builds"
description:
  "A ppx rewriter that keeps one OCaml codebase for native and Melange builds: let%melange_only, [@melange_only], [@native_only] and match%platform pick the code that each target compiles."
maintainer: ["David Sancho <dsnxmoreno@gmail.com>"]
authors: ["David Sancho <dsnxmoreno@gmail.com>"]
license: "MIT"
homepage: "https://github.com/ml-in-barcelona/ppx_platform"
bug-reports: "https://github.com/ml-in-barcelona/ppx_platform/issues"
depends: [
  "dune" {>= "3.26"}
  "ocaml" {>= "4.14.1"}
  "ppxlib" {>= "0.36.0"}
  "melange" {>= "3.0.0"}
  "reason" {with-test}
  "ocamlformat" {= "0.28.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ml-in-barcelona/ppx_platform.git"
x-maintenance-intent: ["(latest)"]
x-ci-accept-failures: ["cygwin-mingw"]
pin-depends: [
  [
    "dune.dev"
    "git+https://github.com/anmonteiro/dune.git#9e15502dcccd96a5bd66bbbb66eb6e9b937b06e2"
  ]
]
